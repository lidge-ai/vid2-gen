{
  "$schema": "https://raw.githubusercontent.com/lidge-ai/vid2-gen/main/schema/timeline.v1.json",
  "version": 1,
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "background": "#0B0D12"
  },
  "beat": {
    "bpm": 120
  },
  "sources": {
    "code": {
      "type": "capture",
      "session": "code.vid2cap"
    },
    "app": {
      "type": "capture",
      "session": "app.vid2cap"
    },
    "hero": {
      "type": "image",
      "path": "media/hero.jpg"
    },
    "stillA": {
      "type": "image",
      "path": "media/still-a.jpg"
    },
    "stillB": {
      "type": "image",
      "path": "media/still-b.jpg"
    },
    "qaContact": {
      "type": "image",
      "path": "media/qa-contact.png"
    },
    "qaSeamA": {
      "type": "image",
      "path": "media/qa-seam-a.png"
    },
    "qaSeamB": {
      "type": "image",
      "path": "media/qa-seam-b.png"
    }
  },
  "scenes": [
    {
      "id": "file",
      "duration": "2s",
      "background": "#0B0D12",
      "layers": [
        {
          "type": "media",
          "source": "stillA",
          "fit": "cover",
          "motion": "drift",
          "opacity": 0.55
        },
        {
          "type": "text",
          "text": "The edit is a file.",
          "x": 160,
          "y": 540,
          "align": "left",
          "font": "sans",
          "weight": "black",
          "size": 112,
          "color": "#F4F0E8",
          "animation": "slam",
          "start": "0.15s"
        }
      ]
    },
    {
      "id": "write",
      "duration": "4s",
      "background": "#0B0D12",
      "layers": [
        {
          "type": "media",
          "source": "code",
          "in": {
            "event": "goto#1",
            "offset": "0.3s"
          },
          "camera": [
            {
              "at": 0,
              "zoom": 1.02,
              "x": 0.34,
              "y": 0.42,
              "ease": "inout"
            },
            {
              "at": "4s",
              "zoom": 1.14,
              "x": 0.44,
              "y": 0.4,
              "ease": "inout"
            }
          ]
        },
        {
          "type": "shape",
          "shape": "rect",
          "x": 0,
          "y": 860,
          "width": 1920,
          "height": 220,
          "color": "#0B0D12E0"
        },
        {
          "type": "text",
          "text": "Write the timeline.",
          "x": 160,
          "y": 970,
          "align": "left",
          "font": "sans",
          "weight": "black",
          "size": 72,
          "color": "#F4F0E8",
          "animation": "rise",
          "start": "0.35s"
        }
      ]
    },
    {
      "id": "capture",
      "duration": "4.25s",
      "background": "#0B0D12",
      "transition": {
        "type": "fade",
        "duration": "0.25s"
      },
      "layers": [
        {
          "type": "media",
          "source": "app",
          "in": {
            "event": "goto#1",
            "offset": "0.1s"
          },
          "camera": {
            "auto": "events",
            "zoom": 1.7
          },
          "cursor": {
            "style": "arrow",
            "ripple": true
          }
        },
        {
          "type": "shape",
          "shape": "rect",
          "x": 0,
          "y": 860,
          "width": 1920,
          "height": 220,
          "color": "#0B0D12E0"
        },
        {
          "type": "text",
          "text": "Capture the real product.",
          "x": 160,
          "y": 970,
          "align": "left",
          "font": "sans",
          "weight": "black",
          "size": 72,
          "color": "#F4F0E8",
          "animation": "rise",
          "start": "0.35s"
        }
      ]
    },
    {
      "id": "choose",
      "duration": "4s",
      "background": "#E8E3D8",
      "layers": [
        {
          "type": "text",
          "text": "Choose the shot.",
          "x": 160,
          "y": 170,
          "align": "left",
          "font": "sans",
          "weight": "black",
          "size": 72,
          "color": "#14171F",
          "animation": "rise",
          "start": "0.2s"
        },
        {
          "type": "media",
          "source": "stillA",
          "fit": "cover",
          "motion": "drift",
          "window": {
            "x": 160,
            "y": 300,
            "width": 560,
            "height": 374,
            "radius": 20,
            "perspective": {
              "rx": 0,
              "ry": 10
            }
          },
          "start": "0.1s"
        },
        {
          "type": "media",
          "source": "hero",
          "fit": "cover",
          "motion": "kenburns",
          "window": {
            "x": 680,
            "y": 340,
            "width": 560,
            "height": 374,
            "radius": 20
          },
          "start": "0.35s"
        },
        {
          "type": "media",
          "source": "stillB",
          "fit": "cover",
          "motion": "drift",
          "window": {
            "x": 1200,
            "y": 300,
            "width": 560,
            "height": 374,
            "radius": 20,
            "perspective": {
              "rx": 0,
              "ry": -10
            }
          },
          "start": "0.6s"
        },
        {
          "type": "text",
          "text": "hero.jpg  ·  still-a.jpg  ·  still-b.jpg — generated with ima2-gen",
          "x": 160,
          "y": 880,
          "align": "left",
          "font": "mono",
          "weight": "regular",
          "size": 30,
          "color": "#5B6070",
          "animation": "fade",
          "start": "1s"
        }
      ]
    },
    {
      "id": "assets",
      "duration": "4s",
      "background": "#0B0D12",
      "layers": [
        {
          "type": "media",
          "source": "hero",
          "fit": "cover",
          "camera": [
            {
              "at": 0,
              "zoom": 1,
              "x": 0.5,
              "y": 0.5,
              "ease": "out"
            },
            {
              "at": "4s",
              "zoom": 1.1,
              "x": 0.46,
              "y": 0.52,
              "ease": "out"
            }
          ]
        },
        {
          "type": "shape",
          "shape": "rect",
          "x": 0,
          "y": 860,
          "width": 1920,
          "height": 220,
          "color": "#0B0D12E0"
        },
        {
          "type": "text",
          "text": "Turn assets into motion.",
          "x": 160,
          "y": 970,
          "align": "left",
          "font": "sans",
          "weight": "black",
          "size": 72,
          "color": "#F4F0E8",
          "animation": "rise",
          "start": "0.1s"
        }
      ]
    },
    {
      "id": "compile",
      "duration": "4.25s",
      "background": "#0B0D12",
      "transition": {
        "type": "slideleft",
        "duration": "0.25s"
      },
      "layers": [
        {
          "type": "media",
          "source": "code",
          "in": {
            "event": "run",
            "offset": "-0.6s"
          },
          "camera": [
            {
              "at": 0,
              "zoom": 1.5,
              "x": 0.72,
              "y": 0.36,
              "ease": "inout"
            },
            {
              "at": "4.25s",
              "zoom": 1.62,
              "x": 0.74,
              "y": 0.38,
              "ease": "inout"
            }
          ],
          "cursor": {
            "style": "arrow",
            "ripple": true
          }
        },
        {
          "type": "shape",
          "shape": "rect",
          "x": 0,
          "y": 860,
          "width": 1920,
          "height": 220,
          "color": "#0B0D12E0"
        },
        {
          "type": "text",
          "text": "Compile every frame.",
          "x": 160,
          "y": 970,
          "align": "left",
          "font": "sans",
          "weight": "black",
          "size": 72,
          "color": "#F4F0E8",
          "animation": "rise",
          "start": "0.35s"
        }
      ]
    },
    {
      "id": "inspect",
      "duration": "4s",
      "background": "#101318",
      "layers": [
        {
          "type": "media",
          "source": "qaContact",
          "fit": "contain",
          "window": {
            "x": 160,
            "y": 120,
            "width": 1060,
            "height": 640,
            "radius": 16
          },
          "motion": "drift"
        },
        {
          "type": "media",
          "source": "qaSeamA",
          "fit": "cover",
          "window": {
            "x": 1300,
            "y": 120,
            "width": 460,
            "height": 259,
            "radius": 14
          },
          "start": "0.4s"
        },
        {
          "type": "media",
          "source": "qaSeamB",
          "fit": "cover",
          "window": {
            "x": 1300,
            "y": 420,
            "width": 460,
            "height": 259,
            "radius": 14
          },
          "start": "0.7s"
        },
        {
          "type": "text",
          "text": "vid2 qa  →  contact sheet, seams, loudness",
          "x": 1300,
          "y": 740,
          "align": "left",
          "font": "mono",
          "weight": "regular",
          "size": 26,
          "color": "#8A93A6",
          "animation": "fade",
          "start": "1s"
        },
        {
          "type": "shape",
          "shape": "rect",
          "x": 0,
          "y": 860,
          "width": 1920,
          "height": 220,
          "color": "#0B0D12E0"
        },
        {
          "type": "text",
          "text": "Inspect every cut.",
          "x": 160,
          "y": 970,
          "align": "left",
          "font": "sans",
          "weight": "black",
          "size": 72,
          "color": "#F4F0E8",
          "animation": "rise",
          "start": "0.35s"
        }
      ]
    },
    {
      "id": "ship",
      "duration": "4s",
      "background": "#0B0D12",
      "layers": [
        {
          "type": "text",
          "text": "vid2",
          "x": 160,
          "y": 420,
          "align": "left",
          "font": "sans",
          "weight": "black",
          "size": 220,
          "color": "#F4F0E8",
          "animation": "slam",
          "start": "0.1s"
        },
        {
          "type": "text",
          "text": "Ship the video.",
          "x": 170,
          "y": 590,
          "align": "left",
          "font": "serif",
          "weight": "italic",
          "size": 84,
          "color": "#8FB3FF",
          "animation": "fade",
          "start": "0.6s"
        },
        {
          "type": "shape",
          "shape": "rect",
          "x": 160,
          "y": 700,
          "width": 760,
          "height": 96,
          "color": "#1A2030",
          "radius": 14,
          "start": "1s"
        },
        {
          "type": "text",
          "text": "npm i -g vid2-gen",
          "x": 196,
          "y": 750,
          "align": "left",
          "font": "mono",
          "weight": "regular",
          "size": 44,
          "color": "#B7E38C",
          "animation": "type",
          "start": "1.1s",
          "animationDuration": "0.6s"
        }
      ]
    }
  ],
  "audio": {
    "music": {
      "synth": {
        "preset": "launch",
        "key": "Am",
        "sections": [
          {
            "at": 0,
            "energy": "intro"
          },
          {
            "at": "6s",
            "energy": "build"
          },
          {
            "at": "14s",
            "energy": "drop"
          },
          {
            "at": "26s",
            "energy": "outro"
          }
        ]
      },
      "volume": 1,
      "fadeOut": "1.5s"
    },
    "cues": [
      {
        "at": 0,
        "sfx": "preset:click"
      },
      {
        "at": "14s",
        "sfx": "preset:riser",
        "anchor": "end",
        "volume": 0.9
      }
    ],
    "autoCues": true
  }
}
